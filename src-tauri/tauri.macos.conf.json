{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Escouade",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 16 },
        "center": true,
        "visible": false,
        "backgroundColor": "#191715",
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist",
      "files": {
        "Resources/fr.lproj/InfoPlist.strings": "./macos/fr.lproj/InfoPlist.strings",
        "Resources/en.lproj/InfoPlist.strings": "./macos/en.lproj/InfoPlist.strings"
      }
    }
  }
}
